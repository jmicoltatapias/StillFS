STILLFS_HTTP_PORT=9000
STILLFS_DB_NAME=stillfs
STILLFS_DB_USER=stillfs
STILLFS_DB_PASSWORD=stillfs-dev-password
# Generate a persistent 32-byte key with: openssl rand -base64 32
# Store the value in this file with mode 0600. Do not rotate without
# re-encrypting existing credentials.
# STILLFS_CREDENTIAL_ENCRYPTION_KEY=
STILLFS_S3_REGION=us-east-1
STILLFS_S3_CLOCK_SKEW=5m
